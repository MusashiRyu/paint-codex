<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Portrait only, matching UISupportedInterfaceOrientations in
             ios/App/App/Info.plist. The layout is a single phone-width card
             tuned at portrait widths, and the tall sheet's 88% height leaves
             no room above it in landscape.

             `configChanges` still lists `orientation`, and stays: it stops the
             activity being recreated on the config changes it does see, which
             would otherwise reload the WebView and lose the open sheet.

             Caveat for large screens: this app targets SDK 36, and Android 16
             ignores orientation restrictions on displays 600dp and wider. A
             foldable opened flat will rotate regardless. That is the platform's
             call to make, and this app is phones-only for now. -->
        <!-- `windowSoftInputMode` is what stops the keyboard being paid for
             twice. Capacitor already resizes the web view for it: the
             `SystemBars` plugin pads the web view's *parent* by the IME inset
             whenever the keyboard is visible, in `initWindowInsetsListener`.

             On Android 15+ that padding is the only adjustment there is. An app
             targeting SDK 35 is edge-to-edge, its window is never resized for
             the keyboard, and the padding is what makes room. Below 15 the
             window *is* resized — the platform default is `adjustResize` — and
             the plugin's padding is then taken a second time out of a view that
             has already shrunk. On a Galaxy S9 (Android 10, a 740px-tall
             viewport under a 353px keyboard) that leaves the web view about
             34px tall: the search sheet's header alone under the status bar,
             and the window background — black — for the rest of the screen.
             Upstream as ionic-team/capacitor#8466.

             `adjustNothing` leaves the window alone on every version, so the
             plugin's padding is the single adjustment everywhere and old and
             new devices behave alike. The plugin still gets its inset: real on
             API 30+, where the IME insets are dispatched whatever the adjust
             mode, and on API 29 derived by androidx from the root view's
             visible insets, which track the keyboard whatever the mode. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:windowSoftInputMode="adjustNothing"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
